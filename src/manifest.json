{
    "manifest_version": 3,
    "browser_specific_settings": {
        "gecko": {
            "id": "henrik.develops@gmail.com",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "name": "Copy That",
    "version": "2.1.0",
    "description": "Click an element on the page to copy it to the clipboard. Math can be copied as Office Math Objects (OMML), LaTeX, or MathML.",
    "permissions": [
        "activeTab",
        "scripting",
        "clipboardWrite",
        "storage"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "action": {
        "default_title": "Activate Copy That",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "images/icon16.png",
            "32": "images/icon48.png",
            "48": "images/icon48.png"
        }
    },
    "icons": {
        "16": "images/icon16.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    }
}