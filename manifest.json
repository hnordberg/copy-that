{
  "manifest_version": 3,
  "name": "Copy That",
  "version": "2.0",
  "description": "Click an element on the page to copy it to the clipboard. Math is converted to OMML for native rendering in Word.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Activate Copy That"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
