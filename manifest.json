{
  "manifest_version": 3,
  "name": "Copy That",
  "version": "1.0",
  "description": "Click an element on the page to copy its innerText or innerHTML to the clipboard.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Activate Copy That"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
