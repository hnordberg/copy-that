{
  "manifest_version": 2,
  "name": "Copy That (V2)",
  "version": "1.0",
  "description": "Click an element on the page to copy its innerText (Manifest V2 version).",
  "applications": {
      "gecko": {
          "id": "<your email address>"
      }
  },
  "permissions": [
    "activeTab",
    "clipboardWrite"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Activate Copy That (V2)"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png"
  }
}